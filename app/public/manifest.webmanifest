{
  "name": "Planéalo · HAM Menorca",
  "short_name": "Planéalo",
  "description": "Mi día, capturar y planificar",
  "lang": "es",
  "start_url": "/inicio.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141414",
  "theme_color": "#141414",
  "icons": [
    {
      "src": "/icono-192-v2.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icono-512-v2.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icono-512-maskable-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivos",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            ".pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".odt",
            ".ods",
            ".txt",
            ".csv",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/plain"
          ]
        }
      ]
    }
  }
}