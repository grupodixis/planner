{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grupodixis/planner/semillero/esquema.json",
  "title": "s360 · Semillero de recursos de la empresa (s360-semillero/1)",
  "description": "Departamentos, áreas de trabajo, tipos de recurso (oficios, máquinas, subcontratas) y recursos. Lo usan el planificador (lo carga) y el compositor (usa los mismos nombres). Ver semillero/README.md.",
  "type": "object",
  "required": ["formato", "departamentos", "tipos", "areas", "recursos"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": "s360-semillero/1" },
    "empresa": { "type": "string", "maxLength": 120 },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string", "maxLength": 2000 },
    "departamentos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["clave", "nombre"], "additionalProperties": false,
        "properties": {
          "clave": { "$ref": "#/$defs/clave" },
          "nombre": { "$ref": "#/$defs/nombre" }
        }
      }
    },
    "tipos": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "operario": { "$ref": "#/$defs/listaTipos" },
        "maquina": { "$ref": "#/$defs/listaTipos" },
        "subcontrata": { "$ref": "#/$defs/listaTipos" }
      }
    },
    "requisitos_sin_control": {
      "type": "object", "additionalProperties": false, "required": ["nombres"],
      "properties": {
        "descripcion": { "type": "string" },
        "nombres": { "type": "array", "items": { "$ref": "#/$defs/nombre" } }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object", "required": ["ref", "nombre", "departamento", "tipo"], "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/clave" },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
          "departamento": { "$ref": "#/$defs/clave" },
          "tipo": { "enum": ["taller", "oficina", "pintura", "transporte", "otro"], "description": "Las obras no van aquí: son de cada proyecto." },
          "exclusiva": { "type": "boolean", "default": false, "description": "Un solo trabajo a la vez (puestos de oficina, máquinas fijas). Si coinciden dos, aviso." },
          "descripcion": { "type": "string", "maxLength": 200 },
          "ubicacion": { "type": "string", "maxLength": 200 },
          "antes": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Nombres que tenía en el planificador (se renombra en vez de crear otra)." },
          "antes_recursos": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Máquinas dadas de alta como recurso que en realidad son esta área: sus requisitos pasan a ser el área de la tarea." },
          "alias": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Otros nombres de esta área (p. ej. los del compositor) para la importación." },
          "alias_requisito": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Si el compositor pide uno de estos nombres en «requiere», la tarea va a esta área en vez de pedir un recurso." }
        }
      }
    },
    "recursos": {
      "type": "array",
      "items": {
        "type": "object", "required": ["ref", "clase", "nombre"], "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/clave" },
          "clase": { "enum": ["operario", "maquina", "subcontrata"] },
          "nombre": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
          "departamento": { "$ref": "#/$defs/clave" },
          "area_habitual": { "$ref": "#/$defs/clave", "description": "ref de un área (su puesto o ubicación habitual)." },
          "codigo": { "type": "string", "maxLength": 30, "description": "Nº de empleado, nº de máquina o matrícula." },
          "vinculo": { "enum": ["plantilla", "subcontratado"], "description": "Solo operarios." },
          "categoria": { "enum": ["Subcontrata", "Alquiler"], "description": "Solo subcontratas." },
          "empresa": { "type": "string", "maxLength": 120 },
          "oficios": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Solo operarios: nombres de tipos.operario." },
          "tipos": { "type": "array", "items": { "$ref": "#/$defs/nombre" }, "description": "Máquinas y subcontratas: nombres de tipos.maquina / tipos.subcontrata." },
          "descripcion": { "type": "string", "maxLength": 2000 },
          "antes": { "type": "array", "items": { "$ref": "#/$defs/nombre" } }
        }
      }
    },
    "ubicaciones": { "type": "object" },
    "inventario_sin_planificar": { "type": "object" }
  },
  "$defs": {
    "clave": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
    "nombre": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "listaTipos": {
      "type": "array",
      "items": {
        "type": "object", "required": ["nombre"], "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
          "alias": { "type": "array", "items": { "$ref": "#/$defs/nombre" } },
          "descripcion": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
