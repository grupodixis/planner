# Copia este archivo a .env y cambia las contraseñas antes de usarlo en serio
POSTGRES_DB=s360
POSTGRES_USER=s360
POSTGRES_PASSWORD=s360_cambiame

# Usuario administrador que se crea al primer arranque
ADMIN_EMAIL=admin@s360.local
ADMIN_PASSWORD=cambiame

# Puerto donde se publica la web en tu máquina: http://localhost:8080
WEB_PORT=8080

# Pon true si la sirves detrás de HTTPS
COOKIE_SECURE=false

# Dirección pública de la web, para los enlaces de activación / recuperar contraseña.
# Si se deja vacía se usa la dirección con la que entra quien da de alta al usuario.
APP_URL=

# Correo (opcional). Sin SMTP_HOST no se envían correos: los enlaces de alta y de
# recuperación los copia un administrador desde la pantalla Usuarios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Planificador s360 <planificador@tu-dominio.com>

# Jornada laboral (horas; 7.5 = 07:30). Al soltar una tarea se planifica hasta el fin
# de jornada; el tablero muestra 2h más para horas extra.
JORNADA_INICIO=7
JORNADA_FIN=15

# Días laborables de vacaciones al año por convenio (cada persona puede tener los suyos)
VACACIONES_DIAS=22
