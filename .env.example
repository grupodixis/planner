# Copia este archivo a .env y cambia las contraseñas antes de usarlo en serio
POSTGRES_DB=s360
POSTGRES_USER=s360
POSTGRES_PASSWORD=s360_cambiame

# Usuario administrador que se crea al primer arranque
ADMIN_EMAIL=admin@s360.local
ADMIN_PASSWORD=cambiame

# Puerto donde se publica la web en tu máquina: http://localhost:8080
WEB_PORT=8080

# Pon true si la sirves detrás de HTTPS
COOKIE_SECURE=false

# Jornada laboral (horas; 7.5 = 07:30). Al soltar una tarea se planifica hasta el fin
# de jornada; el tablero muestra 2h más para horas extra.
JORNADA_INICIO=7
JORNADA_FIN=15
